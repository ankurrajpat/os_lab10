diff --git a/vm.c b/vm.c
index 7134cff..e655139 100644
--- a/vm.c
+++ b/vm.c
@@ -114,6 +114,52 @@ static struct kmap {
  { (void*)DEVSPACE, DEVSPACE,      0,         PTE_W}, // more devices
 };
 
+// Assignment 10 Q2: translate a virtual address to a physical address
+// using walkpgdir().  Returns 0 and stores the result in *pa on success,
+// -1 when the address has no valid, present page-table entry.
+int
+v2paddr(pde_t *pgdir, uint va, uint *pa)
+{
+  pte_t *pte;
+
+  pte = walkpgdir(pgdir, (void*)va, 0);   // alloc=0: never create entries
+  if(pte == 0 || !(*pte & PTE_P) || !(*pte & PTE_U))         // entry must exist and be present
+    return -1;
+  *pa = PTE_ADDR(*pte) | (va & 0xFFF);    // frame base + offset within page
+  return 0;
+}
+
+// Assignment 10 Q3a: fetch the physical frame number and the page-table
+// flags (P, W, U) of the page holding virtual address va.
+int
+pageinfofor(pde_t *pgdir, uint va, uint *frame, uint *flags)
+{
+  pte_t *pte;
+
+  pte = walkpgdir(pgdir, (void*)va, 0);
+  if(pte == 0 || !(*pte & PTE_P) || !(*pte & PTE_U))
+    return -1;
+  *frame = PTE_ADDR(*pte) >> 12;          // physical frame number
+  *flags = *pte & 0xFFF;                  // low 12 bits hold the flags
+  return 0;
+}
+
+// Assignment 10 Q3b: remove write permission (PTE_W) from the page-table
+// entry of the page holding va.  Returns 0 on success, -1 if unmapped.
+int
+setreadonlypage(pde_t *pgdir, uint va)
+{
+  pte_t *pte;
+
+  pte = walkpgdir(pgdir, (void*)va, 0);
+  if(pte == 0 || !(*pte & PTE_P) || !(*pte & PTE_U))
+    return -1;
+  *pte = *pte & ~PTE_W;                   // clear the writable bit
+  lcr3(V2P(pgdir));                       // flush the TLB so the new
+                                          // permission takes effect at once
+  return 0;
+}
+
 // Set up kernel part of a page table.
 pde_t*
 setupkvm(void)
