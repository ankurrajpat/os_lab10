+// Assignment 10 Q1: report allocator statistics for the memstats() syscall.
+// total_alloc/total_free count successful runtime operations; avail counts pages
+// currently sitting on the free list.
+void
+getmemstats(int *total_alloc, int *total_free, int *avail)
+{
+  struct run *r;
+
+  if(kmem.use_lock)
+    acquire(&kmem.lock);
+  *total_alloc = kmem.nalloc;
+  *total_free = kmem.nfree;
+  *avail = 0;
+  for(r = kmem.freelist; r; r = r->next)
+    (*avail)++;
+  if(kmem.use_lock)
+    release(&kmem.lock);
+}
+
